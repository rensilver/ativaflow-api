# Copie para .env e preencha a senha do PostgreSQL local.
# O Spring Boot não carrega .env automaticamente; veja README.md.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/ativaflow
DB_USERNAME=ativaflow
DB_PASSWORD=
DB_CONNECTION_TIMEOUT_MS=30000
WORKER_ENABLED=true
WORKER_POLL_INTERVAL=250ms
WORKER_LEASE_DURATION=30s
WORKER_RETRY_MAX_ATTEMPTS=3
WORKER_RETRY_INITIAL_DELAY=1s
WORKER_RETRY_MAX_DELAY=1m
WORKER_RETRY_JITTER_RATIO=0.25
ACTIVATION_PROVIDER_BASE_URL=http://localhost:8081
ACTIVATION_PROVIDER_CONNECT_TIMEOUT=2s
ACTIVATION_PROVIDER_READ_TIMEOUT=5s
# Opcional: somente se o contrato do provedor exigir autenticação por API key.
ACTIVATION_PROVIDER_API_KEY=
SHUTDOWN_TIMEOUT=30s

# Resource Server: preencha o emissor confiável; não há login ou emissão de tokens na API.
# client_id/client_secret M2M pertencem ao consumidor, não são configurados nesta API.
# Emissor/cofre de produção ainda não definidos. Origem e rotação: docs/resource-server.md.
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUERURI=
# Perfil local: audience(s) obrigatória(s), separadas por vírgula; o token precisa conter uma delas.
# Contrato local: RS256, iss e exp obrigatórios, nbf opcional e token_use=access.
# O env.sh do utilitário configura a audience de demonstração (ativaflow-api).
# Para emissores externos, adote as regras de audience/finalidade do contrato real.
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES=
# Emissor externo: opcional, quando o JWKS é informado diretamente, sem discovery.
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWKSETURI=https://emissor.example/jwks
# Desenvolvimento com perfil local: arquivo PEM X.509 de chave pública RSA (RS256).
# Gere com: export JWT_DEMO_DIR="$(java scripts/LocalJwt.java create)"
# Depois de carregar este .env: source "$JWT_DEMO_DIR/env.sh"
# O env.sh configura issuer, audience e PEM; não combine PEM e JWKSETURI.
# Roteiro de PEM/JWKS, renovação e limpeza: docs/local-jwt.md.
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_PUBLICKEYLOCATION=file:/tmp/ativaflow-jwt.XXXXXX/public.pem
# Compose: caminho no host para a cópia da chave pública, legível pelo UID 10001.
# O Compose fixa perfil local, porta interna 8080 e URLs de banco/provedor na rede interna.
# SERVER_PORT altera somente a porta publicada da API. Veja docs/container-image.md.
# JWT_PUBLIC_KEY_FILE=./.env.jwt-public.pem
