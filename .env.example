# Copie para .env e preencha a senha do PostgreSQL local.
# O Spring Boot não carrega .env automaticamente; veja README.md.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/ativaflow
DB_USERNAME=ativaflow
DB_PASSWORD=
DB_CONNECTION_TIMEOUT_MS=30000
WORKER_LEASE_DURATION=30s
WORKER_RETRY_MAX_ATTEMPTS=3
WORKER_RETRY_INITIAL_DELAY=1s
WORKER_RETRY_MAX_DELAY=1m
WORKER_RETRY_JITTER_RATIO=0.25
ACTIVATION_PROVIDER_BASE_URL=http://localhost:8081
ACTIVATION_PROVIDER_CONNECT_TIMEOUT=2s
ACTIVATION_PROVIDER_READ_TIMEOUT=5s
# Opcional: somente se o contrato do provedor exigir autenticação por API key.
ACTIVATION_PROVIDER_API_KEY=
SHUTDOWN_TIMEOUT=30s
